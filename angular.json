{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "cli": {
    "analytics": false,
    "schematicCollections": [
      "@schematics/angular"
    ]
  },
  "schematics": {
    "@schematics/angular:component": {
      "style": "scss"
    }
  },
  "projects": {
    "portfolio": {
      "projectType": "application",
      "root": "projects/portfolio",
      "sourceRoot": "projects/portfolio/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/portfolio/src/main.ts",
            "tsConfig": "projects/portfolio/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "outputPath": "dist/portfolio",
            "index": "projects/portfolio/src/index.html",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "content.json",
                "input": "projects/core/src/lib/data",
                "output": "."
              }
            ],
            "styles": [
              "projects/portfolio/src/styles.scss"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "700kB",
                  "maximumError": "1.5MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "12kB",
                  "maximumError": "24kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "portfolio:build:production"
            },
            "development": {
              "buildTarget": "portfolio:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "projects/portfolio/tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "content.json",
                "input": "projects/core/src/lib/data",
                "output": "."
              }
            ],
            "styles": [
              "projects/portfolio/src/styles.scss"
            ]
          }
        }
      }
    },
    "core": {
      "projectType": "library",
      "root": "projects/core",
      "sourceRoot": "projects/core/src",
      "prefix": "pc",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "project": "projects/core/ng-package.json",
            "tsConfig": "projects/core/tsconfig.lib.json"
          },
          "defaultConfiguration": "production",
          "configurations": {
            "production": {},
            "development": {}
          }
        }
      }
    },
    "ui": {
      "projectType": "library",
      "root": "projects/ui",
      "sourceRoot": "projects/ui/src",
      "prefix": "pc",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "project": "projects/ui/ng-package.json",
            "tsConfig": "projects/ui/tsconfig.lib.json"
          },
          "defaultConfiguration": "production",
          "configurations": {
            "production": {},
            "development": {}
          }
        }
      }
    },
    "shop-core": {
      "projectType": "library",
      "root": "projects/shop-core",
      "sourceRoot": "projects/shop-core/src",
      "prefix": "pc",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "project": "projects/shop-core/ng-package.json",
            "tsConfig": "projects/shop-core/tsconfig.lib.json"
          },
          "defaultConfiguration": "production",
          "configurations": {
            "production": {},
            "development": {}
          }
        }
      }
    },
    "shop": {
      "projectType": "application",
      "root": "projects/shop",
      "sourceRoot": "projects/shop/src",
      "prefix": "shop",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/shop/src/main.ts",
            "tsConfig": "projects/shop/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "outputPath": "dist/shop",
            "index": "projects/shop/src/index.html",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/shop/public"
              },
              {
                "glob": "catalog.json",
                "input": "projects/shop-core/src/lib/data",
                "output": "."
              }
            ],
            "styles": [
              "projects/shop/src/styles.scss"
            ],
            "allowedCommonJsDependencies": [
              "qrcode"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "900kB",
                  "maximumError": "2MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "14kB",
                  "maximumError": "30kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "shop:build:production"
            },
            "development": {
              "buildTarget": "shop:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "projects/shop/tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/shop/public"
              },
              {
                "glob": "catalog.json",
                "input": "projects/shop-core/src/lib/data",
                "output": "."
              }
            ],
            "styles": [
              "projects/shop/src/styles.scss"
            ]
          }
        }
      }
    },
    "medicare-core": {
      "projectType": "library",
      "root": "projects/medicare-core",
      "sourceRoot": "projects/medicare-core/src",
      "prefix": "pc",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "project": "projects/medicare-core/ng-package.json",
            "tsConfig": "projects/medicare-core/tsconfig.lib.json"
          },
          "defaultConfiguration": "production",
          "configurations": {
            "production": {},
            "development": {}
          }
        }
      }
    },
    "medicare": {
      "projectType": "application",
      "root": "projects/medicare",
      "sourceRoot": "projects/medicare/src",
      "prefix": "mc",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/medicare/src/main.ts",
            "tsConfig": "projects/medicare/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "outputPath": "dist/medicare",
            "index": "projects/medicare/src/index.html",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/medicare/public"
              }
            ],
            "styles": [
              "projects/medicare/src/styles.scss"
            ],
            "allowedCommonJsDependencies": [
              "qrcode"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "900kB",
                  "maximumError": "2MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "16kB",
                  "maximumError": "40kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "medicare:build:production"
            },
            "development": {
              "buildTarget": "medicare:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "projects/medicare/tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/medicare/public"
              }
            ],
            "styles": [
              "projects/medicare/src/styles.scss"
            ]
          }
        }
      }
    }
  }
}
