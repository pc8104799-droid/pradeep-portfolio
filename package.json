{
  "name": "portfolio",
  "version": "1.0.0",
  "description": "Angular 22 monorepo — portfolio, FreshKart storefront and MediCare360 hospital platform, with an Express API.",
  "scripts": {
    "ng": "ng",
    "start": "ng serve portfolio",
    "start:shop": "ng serve shop",
    "build": "ng build portfolio",
    "build:shop": "ng build shop",
    "build:libs": "ng build core && ng build ui && ng build shop-core && ng build medicare-core",
    "build:all": "npm run build:libs && ng build portfolio && ng build shop && ng build medicare",
    "test": "ng test portfolio",
    "test:shop": "ng test shop",
    "start:medicare": "ng serve medicare",
    "build:medicare": "ng build medicare",
    "test:medicare": "ng test medicare",
    "api": "node server/src/index.js",
    "api:seed": "node server/src/db/seed.js --force",
    "test:all": "ng test portfolio --watch=false --browsers=ChromeHeadless && ng test shop --watch=false --browsers=ChromeHeadless && ng test medicare --watch=false --browsers=ChromeHeadless",
    "api:test": "node server/test/api.test.mjs"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.1.3",
    "@angular/compiler": "^22.1.3",
    "@angular/core": "^22.1.3",
    "@angular/forms": "^22.1.3",
    "@angular/platform-browser": "^22.1.3",
    "@angular/router": "^22.1.3",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.5",
    "@angular/cli": "^22.1.5",
    "@angular/compiler-cli": "^22.1.3",
    "@types/jasmine": "~5.1.0",
    "@types/qrcode": "^1.5.6",
    "jasmine-core": "~5.7.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^22.1.1",
    "typescript": "~6.0.0"
  },
  "workspaces": [
    "projects/*",
    "server"
  ]
}
