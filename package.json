{
  "name": "portfolio",
  "version": "1.0.0",
  "description": "Pradeep Chauhan — Senior Front-End Developer portfolio, built with Angular 22.",
  "scripts": {
    "ng": "ng",
    "start": "ng serve portfolio",
    "start:shop": "ng serve shop",
